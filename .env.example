# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Seu usuário do GitHub (os projetos são carregados dele)
VITE_GITHUB_USERNAME=seu-usuario

# Supabase: Project Settings > API (use a chave "anon/public", nunca a service_role)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Formspree: crie um form em formspree.io e copie a URL (ex.: https://formspree.io/f/abcdwxyz)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
